[Unit]
Description=Bichi Mail new Inbox summaries (GPT, Jev, GPT; no Telegram receiver)
After=network-online.target
ConditionPathExists=%h/.config/bichi-mail/watch.json

[Service]
Type=oneshot
UMask=0077
EnvironmentFile=%h/.config/bichi-mail/worker.env
LoadCredential=gmail-keyring-password:%h/.config/bichi-mail/gmail-keyring-password
WorkingDirectory=%h/projects/mail-assistant
ExecStart=/usr/bin/python3 %h/projects/mail-assistant/src/mail_watch.py job --config %h/.config/bichi-mail/watch.json --db %h/.local/state/bichi-mail/watch.sqlite3
TimeoutStartSec=30min
NoNewPrivileges=true
StandardOutput=null
StandardError=journal
LimitCORE=0
